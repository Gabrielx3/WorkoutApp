<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFEC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuovo Esercizio"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="cursive"
        android:layout_marginBottom="24dp"
        android:layout_gravity="center_horizontal"
        android:textColor="#000000"/>

    <!-- Casella Nome -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:hint="@string/nome_esercizio"
        android:fontFamily="cursive"
        android:textSize="28sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <!-- Casella Serie -->
    <EditText
        android:id="@+id/etSets"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:hint="@string/serie"
        android:inputType="number"
        android:fontFamily="cursive"
        android:textSize="28sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <!-- Casella Ripetizioni -->
    <EditText
        android:id="@+id/etReps"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:hint="@string/ripetizioni"
        android:inputType="number"
        android:fontFamily="cursive"
        android:textSize="28sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <!-- Casella Recupero -->
    <EditText
        android:id="@+id/etRecovery"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:hint="@string/recupero"
        android:inputType="number"
        android:fontFamily="cursive"
        android:textSize="28sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <!-- Pulsante Salva -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="@string/salva"
        android:layout_marginTop="32dp"
        android:backgroundTint="#D7263D"
        android:textColor="#000000"
        android:fontFamily="cursive"
        android:textSize="32sp"
        android:textStyle="bold"/>

</LinearLayout>